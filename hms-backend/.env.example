# Copy to .env on the server and fill in real values. Never commit the real .env.
# Generate secrets with: openssl rand -hex 32

# ── Runtime ─────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Database (required — app refuses to boot in production without it) ──
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/curelex_prod?retryWrites=true&w=majority

# ── Auth (required — app refuses to boot in production with placeholder values) ──
JWT_SECRET=
JWT_EXPIRES_IN=30d
SSO_SECRET=

# ── Seeded super-admin account (created on first boot if it doesn't exist) ──
SUPER_ADMIN_EMAIL=admin@curelex.in
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_SECRET_KEY=

# ── CORS / frontend origin ───────────────────────────────────────────
CLIENT_URL=https://curelex.in
# Comma-separated list of additional allowed origins (optional)
ALLOWED_ORIGINS=https://curelex.in,https://www.curelex.in

# ── Stripe (required — app refuses to boot in production without STRIPE_SECRET_KEY) ──
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_LITE=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PLUS=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxx

# ── SMTP (Nodemailer transactional email) ────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Curelex HMS
