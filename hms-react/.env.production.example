# Copy to .env.production before running `npm run build` for a live deploy.
# These bake into the static bundle at build time — changing them later requires a rebuild.
# Vite auto-loads .env.production when NODE_ENV=production / `vite build` runs in prod mode.

VITE_API_BASE_URL=https://curelex.in/api
VITE_IMS_API_URL=https://curelex.in/api/v1/ims
VITE_CLINIC_API_URL=https://curelex.in/api/clinic
VITE_SOCKET_URL=https://curelex.in
VITE_GOOGLE_CLIENT_ID=
